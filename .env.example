MC_DATA_DIR=/home/user/minecraft-vanilla-server

SECRETS_DIR=./secrets

RESTIC_REPOSITORY=rclone:remote:minecraft-server-backup

# optional watchdog repository dir
REPO_DIR=/home/user/mc-server-autostart-watchdog

# optional watchdog image name
MC_IMAGE=mc-server-watchdog:latest

# optional backup schedule
BACKUP_CRON_SCHEDULE="15 3 * * *"

# optional backup script name or path relative to the server
BACKUP_SCRIPT_NAME=restic-backup.sh

# optional port overrides
MC_PORT=25565
DYNMAP_PORT=25566
SSH_PORT=2222
